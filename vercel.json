{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "django",
      "bindings": [
        {
          "type": "service",
          "service": "wa_gateway",
          "format": "url",
          "env": "WA_GATEWAY_URL"
        }
      ]
    },
    "wa_gateway": {
      "root": "wa_gateway",
      "runtime": "node"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "backend"
      }
    }
  ]
}
